<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Wifipad" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Dark status bar icons over the light background (the app draws edge to edge). -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The gamepad is always dark, whatever the system theme. -->
    <style name="Theme.Wifipad.Gamepad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gamepad_background</item>
        <!-- Fullscreen also covers the camera cutout (Android 9 to 14; newer versions always do). -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
